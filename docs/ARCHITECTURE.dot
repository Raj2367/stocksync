digraph G {
  rankdir=LR;
  graph [pad="0.2", nodesep="0.45", ranksep="0.7", bgcolor="white", fontname="Arial"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#444444", fillcolor="#f7f7f7"];
  edge [fontname="Arial", fontsize=9, color="#666666"];

  B [label="Browser / Minimal Frontend", fillcolor="#eef2ff"];
  E [label="Public TLS Edge / Reverse Proxy", fillcolor="#eef2ff"];
  G [label="API Gateway\nJWT Auth + Tenant Context", fillcolor="#eaf7ea"];
  O [label="Order Service\nTenant-scoped Orders", fillcolor="#eaf7ea"];
  S [label="Saga Orchestrator\nPersistent Tenant-scoped Sagas", fillcolor="#eaf7ea"];
  I [label="Inventory Service\nShared Catalog + Inventory", fillcolor="#eaf7ea"];
  P [label="Payment Service\nDemo-controlled", fillcolor="#eaf7ea"];
  M [label="MongoDB", shape=cylinder, fillcolor="#fff8dc"];
  PG [label="PostgreSQL", shape=cylinder, fillcolor="#fff8dc"];
  R [label="Redis", shape=cylinder, fillcolor="#fff8dc"];
  K [label="Kafka", shape=component, fillcolor="#fff8dc"];
  V [label="RAG Knowledge Store", shape=cylinder, fillcolor="#fcecff"];
  C [label="Copilot / RAG Module\ninside API Gateway", fillcolor="#fcecff"];
  L [label="Free-tier LLM API", fillcolor="#fcecff"];

  B -> E [label="HTTPS"];
  E -> G [label="private network"];
  G -> O;
  G -> S;
  G -> C;
  O -> M;
  S -> M;
  I -> PG;
  I -> R;
  O -> K [dir=both, label="events"];
  I -> K [dir=both, label="events"];
  P -> K [dir=both, label="events"];
  S -> K [dir=both, label="events"];
  S -> I [label="HTTP compensation /release"];
  C -> O [label="live facts"];
  C -> S [label="live facts"];
  C -> V [label="tenant-filtered retrieval before prompt"];
  C -> L [label="grounded prompt"];
  C -> R [style=dashed, label="stricter per-tenant rate limit"];
  G -> O [style=dashed, label="JWT tenantId -> trusted X-Tenant-Id"];
  G -> S [style=dashed, label="JWT tenantId -> trusted X-Tenant-Id"];
}
