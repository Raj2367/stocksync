# StockSync — Environment Template
# Copy this file to .env and fill in real values before starting the stack.
# Do NOT commit the real .env file — it is gitignored.

# ---------------------------------------------------------------------------
# API Gateway
# ---------------------------------------------------------------------------
PORT=3000
# Secret: used to sign/verify JWTs. Replace with a strong, secret value.
JWT_SECRET=change-me-strong-jwt-secret
MONGO_URI=mongodb://mongodb:27017/auth
REDIS_URL=redis://redis:6379
INVENTORY_SERVICE_URL=http://inventory-service:3002
ORDER_SERVICE_URL=http://order-service:3001
SAGA_SERVICE_URL=http://saga-orchestrator:3004
# Secrets: initial admin/user passwords used only to seed demo tenants.
SEED_ACME_ADMIN_PASSWORD=changeme-acme-admin
SEED_ACME_USER_PASSWORD=changeme-acme-user
SEED_BETA_ADMIN_PASSWORD=changeme-beta-admin
SEED_BETA_USER_PASSWORD=changeme-beta-user

# ---------------------------------------------------------------------------
# Order Service
# ---------------------------------------------------------------------------
PORT=3001
MONGO_URI=mongodb://mongodb:27017/orders
KAFKA_BROKER=kafka:29092

# ---------------------------------------------------------------------------
# Inventory Service
# ---------------------------------------------------------------------------
PORT=3002
DATABASE_URL=postgresql://stocksync:stocksync@postgres:5432/inventory
KAFKA_BROKER=kafka:29092
REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# Payment Service
# ---------------------------------------------------------------------------
PORT=3003
KAFKA_BROKER=kafka:29092
# Demo-only: set to "true" to enable deterministic demo behaviors.
DEMO_MODE=false

# ---------------------------------------------------------------------------
# Saga Orchestrator
# ---------------------------------------------------------------------------
PORT=3004
MONGO_URI=mongodb://mongodb:27017/sagas
KAFKA_BROKER=kafka:29092
INVENTORY_SERVICE_URL=http://inventory-service:3002
ORDER_SERVICE_URL=http://order-service:3001
