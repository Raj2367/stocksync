{
    "name": "order-service",
    "version": "1.0.0",
    "description": "Order service for StockSync",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "start": "node dist/index.js",
        "test": "jest --runInBand --detectOpenHandles",
        "test:watch": "jest --watch --runInBand"
    },
    "dependencies": {
        "express": "^4.18.2",
        "kafkajs": "^2.2.4",
        "mongoose": "^8.0.0",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.19.43",
        "@types/uuid": "^9.0.7",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.1",
        "@types/jest": "^29.5.8",
        "supertest": "^6.3.3",
        "@types/supertest": "^2.0.16"
    }
}