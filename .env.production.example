# StockSync — Production Deployment Environment Template
# Copy this file to .env.production (or load it via your deployment's secret
# manager / CI environment) and replace all placeholder values with real ones.
# This file is a TEMPLATE ONLY — never commit real secrets to source control.

# ---------------------------------------------------------------------------
# API Gateway
# ---------------------------------------------------------------------------
PORT=80
# SECRET: used to sign/verify JWTs. Replace with a strong, secret value.
JWT_SECRET=<SET_STRONG_SECRET>
MONGO_URI=<MONGODB_CONNECTION_STRING>
REDIS_URL=<REDIS_CONNECTION_STRING>
INVENTORY_SERVICE_URL=<INVENTORY_SERVICE_URL>
ORDER_SERVICE_URL=<ORDER_SERVICE_URL>
SAGA_SERVICE_URL=<SAGA_SERVICE_URL>
# SECRET: initial admin/user passwords used only to seed demo tenants.
SEED_ACME_ADMIN_PASSWORD=<SEED_ACME_ADMIN_PASSWORD>
SEED_ACME_USER_PASSWORD=<SEED_ACME_USER_PASSWORD>
SEED_BETA_ADMIN_PASSWORD=<SEED_BETA_ADMIN_PASSWORD>
SEED_BETA_USER_PASSWORD=<SEED_BETA_USER_PASSWORD>

# ---------------------------------------------------------------------------
# Order Service
# ---------------------------------------------------------------------------
PORT=3001
MONGO_URI=<MONGODB_CONNECTION_STRING>
KAFKA_BROKER=<KAFKA_BOOTSTRAP_SERVER>

# ---------------------------------------------------------------------------
# Inventory Service
# ---------------------------------------------------------------------------
PORT=3002
DATABASE_URL=<POSTGRESQL_CONNECTION_STRING>
KAFKA_BROKER=<KAFKA_BOOTSTRAP_SERVER>
REDIS_URL=<REDIS_CONNECTION_STRING>

# ---------------------------------------------------------------------------
# Payment Service
# ---------------------------------------------------------------------------
PORT=3003
KAFKA_BROKER=<KAFKA_BOOTSTRAP_SERVER>
# Demo-only: set to "true" to enable deterministic demo behaviors.
DEMO_MODE=true

# ---------------------------------------------------------------------------
# Saga Orchestrator
# ---------------------------------------------------------------------------
PORT=3004
MONGO_URI=<MONGODB_CONNECTION_STRING>
KAFKA_BROKER=<KAFKA_BOOTSTRAP_SERVER>
INVENTORY_SERVICE_URL=<INVENTORY_SERVICE_URL>
ORDER_SERVICE_URL=<ORDER_SERVICE_URL>
